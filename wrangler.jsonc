{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retro-squares",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
}
